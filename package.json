{
  "name": "sme-sgp-calendario-microfrontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "generate-env": "node scripts/generate-env.js",
    "dev": "npm run generate-env && vite",
    "build": "npm run generate-env && tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "mf:dev": "npm run generate-env && concurrently \"npm run build -- --watch\" \"vite preview --port 5175 --strictPort\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "6.5.2",
    "@fortawesome/free-solid-svg-icons": "6.5.2",
    "@fortawesome/react-fontawesome": "0.2.0",
    "@reduxjs/toolkit": "^1.9.7",
    "antd": "5.4.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.13",
    "formik": "^2.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-redux": "^8.1.3",
    "react-router-dom": "6.26.2",
    "redux": "4.0.4",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "20.14.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^0.34.6",
    "concurrently": "^9.2.1",
    "jsdom": "^22.1.0",
    "typescript": "~5.9.3",
    "vite": "^4.5.3",
    "vitest": "^0.34.6"
  }
}
